    </div>

    <!-- landing.js replaces this with the highlighted, switchable version -->
    <div class="slab" id="slab"><pre style="margin:0; font-family:var(--mono); color:var(--code-tx)">// npm install @floruntime/flo
import { connect } from '@floruntime/flo'

// One connection speaks every primitive
const flo = await connect('localhost:4222')

// KV — versioned, compare-and-swap, TTL
await flo.kv.set('cart:u:48211', cart, { ttl: '24h' })
const { value, version } = await flo.kv.get('cart:u:48211')

// Streams — append to a partitioned commit log
await flo.stream.append('orders', { id: 'ord_9f2ab1', total: 4200 })

// …and read it back through a consumer group
for await (const rec of flo.stream.read('orders', { group: 'billing' })) {
  // Queues — hand the slow half to a worker pool
  await flo.queue.push('invoices', rec.value, { priority: 1 })

  // Time-series — one point per processed order
  await flo.ts.write('orders_processed', 1, { shard: rec.shard })

  await rec.ack()
}</pre></div>
    <div class="rule"></div>
  </section>

  <!-- =================== SPEC PANELS =================== -->
  <section class="specs">
    <div class="spec">
      <div class="spec-h">One binary</div>
      <div class="spec-art center">
        <div class="chip-flo"><div class="n">flo</div><div class="s">no deps</div></div>
      </div>
      <div class="spec-list">
        <div><b>One</b> static binary</div>
        <div><b>Zero</b> external services</div>
        <div><b>One</b> config file</div>
      </div>
    </div>

    <div class="spec">
      <div class="spec-h">Thread-per-shard</div>
      <div class="spec-art" style="gap:9px">
        <div class="shard"><span class="id">shard 0</span><span class="bar"><i style="width:78%"></i></span><span class="core">cpu0</span></div>
        <div class="shard"><span class="id">shard 1</span><span class="bar"><i style="width:54%"></i></span><span class="core">cpu1</span></div>
        <div class="shard"><span class="id">shard 2</span><span class="bar"><i style="width:91%"></i></span><span class="core">cpu2</span></div>
        <div class="shard"><span class="id">shard 3</span><span class="bar"><i style="width:36%"></i></span><span class="core">cpu3</span></div>
      </div>
      <div class="spec-list">
        <div><b>One core</b> owns a partition</div>
        <div><b>Lock-free</b> hot paths</div>
        <div><b>Predictable</b> tail latency</div>
      </div>
    </div>

    <div class="spec">
      <div class="spec-h">One log</div>
      <div class="spec-art">
        <div class="logcells"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i><i></i><i></i><i></i></div>
        <div class="projgrid">
          <div>kv index</div><div>stream tail</div><div>queue heap</div><div>ts columns</div>
        </div>
      </div>
      <div class="spec-list">
        <div><b>Raft</b>-replicated writes</div>
        <div><b>Local</b> projection reads</div>
        <div><b>Hot · warm · cold</b> tiering</div>
      </div>
    </div>

    <div class="spec">
      <div class="spec-h">One protocol</div>
      <div class="spec-art" style="gap:8px">
        <div class="protorow on"><span>Go</span><em>tcp</em></div>
        <div class="protorow"><span>Python</span><em>asyncio</em></div>
        <div class="protorow"><span>JavaScript</span><em>tcp · ws</em></div>
        <div class="protorow"><span>Zig</span><em>native</em></div>
        <div class="protorow"><span>redis-cli</span><em>compatible</em></div>
      </div>
      <div class="spec-list">
        <div><b>Binary TLV</b> wire protocol</div>
        <div><b>REST</b> control API</div>
        <div><b>Redis</b>-compatible KV</div>
      </div>
    </div>
  </section>

  <!-- =================== PRIMITIVES =================== -->
  <section>
    <div class="rule"></div>
    <div class="prims-head" style="padding-top:56px">
      <div class="eyebrow"># Surface</div>
      <h2 class="title">Seven primitives. <em>One log</em> underneath.</h2>
      <p class="lede lede-prose">Four data primitives and three orchestration primitives, each shaped for a different access pattern — sharing one log, one consistency model and one set of clients.</p>
    </div>
    <div class="prims">
      <a class="prim" href="/primitives/kv">
        <span class="tint" style="background:var(--c-kv)"></span>
        <span class="name">KV</span>
        <span class="desc">Versioned key-value with MVCC, CAS, TTL, blocking gets and namespace isolation.</span>
        <span class="path">/primitives/kv</span>
      </a>
      <a class="prim" href="/primitives/streams">
        <span class="tint" style="background:var(--c-strm)"></span>
        <span class="name">Streams</span>
        <span class="desc">Append-only commit logs with consumer groups, partitioning and tiered storage.</span>
        <span class="path">/primitives/streams</span>
      </a>
      <a class="prim" href="/primitives/queues">
        <span class="tint" style="background:var(--c-queue)"></span>
        <span class="name">Queues</span>
        <span class="desc">Priority queues with competing consumers, lease-based delivery and DLQ.</span>
        <span class="path">/primitives/queues</span>
      </a>
      <a class="prim" href="/primitives/time-series">
        <span class="tint" style="background:var(--c-ts)"></span>
        <span class="name">Time-Series</span>
        <span class="desc">Columnar storage with line-protocol ingest, FloQL pipelines and downsampling.</span>
        <span class="path">/primitives/time-series</span>
      </a>
      <a class="prim" href="/orchestration/actions">
        <span class="tint" style="background:var(--c-act)"></span>
        <span class="name">Actions</span>
        <span class="desc">Durable execution of external logic with retries, timeouts and dead-lettering.</span>
        <span class="path">/orchestration/actions</span>
      </a>
      <a class="prim" href="/orchestration/workflows">
        <span class="tint" style="background:var(--c-flow)"></span>
        <span class="name">Workflows</span>
        <span class="desc">Multi-step YAML orchestration with signals, timers and full state replay.</span>
        <span class="path">/orchestration/workflows</span>
      </a>
      <a class="prim" href="/orchestration/processing">
        <span class="tint" style="background:var(--c-proc)"></span>
        <span class="name">Processing</span>
        <span class="desc">Stateful pipelines with windowing, watermarks, checkpointing and operators.</span>
        <span class="path">/orchestration/processing</span>
      </a>
      <a class="prim prim-all" href="/getting-started/introduction">
        <span class="name">All primitives</span>
        <span class="path">docs.floruntime.io →</span>
      </a>
    </div>
  </section>

  <!-- =================== GUARANTEES =================== -->
  <section class="guar">
    <div class="guar-copy">
      <div class="eyebrow"># What it guarantees</div>
      <p>Writes are Raft-replicated and committed before they are acknowledged. Reads are served from <b>local projections</b> — no cross-node round-trip.</p>
      <p>One core owns a partition, so hot paths stay lock-free and tail latency stays predictable. Actions and workflows <b>replay from the same log</b> the data lives in.</p>
      <a href="/architecture/overview">[ ARCHITECTURE → ]</a>
    </div>
    <div class="ual">
      <div class="ual-h"><span>Unified Append Log</span><span>shard 0..N</span></div>
      <div class="ual-lane" id="ual-lane"></div>
      <div class="ual-f"><span>offset 0</span><span style="color:var(--accent)">committed →</span></div>
      <div class="ual-proj">
        <div><div class="n" style="color:var(--c-kv)">kv index</div><div class="s">hash + MVCC chain</div></div>
        <div><div class="n" style="color:var(--c-strm)">stream tail</div><div class="s">ring → segments</div></div>
        <div><div class="n" style="color:var(--c-queue)">queue heap</div><div class="s">priority + leases</div></div>
        <div><div class="n" style="color:var(--c-ts)">ts columns</div><div class="s">blocks + retention</div></div>
      </div>
    </div>
  </section>
</div>

